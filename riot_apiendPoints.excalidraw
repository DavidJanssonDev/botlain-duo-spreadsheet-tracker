      "boundElements": [],
      "updated": 1794756164561,
      "link": null,
      "locked": false,
      "text": "RETURN VALUE: \"AccountDto\"\n\nAccountDto:\n    - puuid   | string |  Encrypted PUUID. Exact length of 78 characters.\n    - gameName| string |  This field may be excluded from the response if the account doesn't have a gameNam\n    - gameName| string |  This field may be excluded from the response if the account doesn't have a tagLine.\n  ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RETURN VALUE: \"AccountDto\"\n\nAccountDto:\n    - puuid   | string |  Encrypted PUUID. Exact length of 78 characters.\n    - gameName| string |  This field may be excluded from the response if the account doesn't have a gameNam\n    - gameName| string |  This field may be excluded from the response if the account doesn't have a tagLine.\n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
