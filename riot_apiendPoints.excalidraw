    },
    {
      "id": "2vJJxqSo9SmZPcGjkCQSR",
      "type": "text",
      "x": 225.40015203410678,
      "y": 219.8481698967947,
      "width": 1199,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC7l",
