    {
      "id": "659HVu5ewRqw9I1HZPYJj",
      "type": "text",
      "x": 253.82191074702928,
      "y": 1731.3665695693032,
      "width": 2266,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC7w",
      "roundness": null,
      "seed": 801096670,
      "version": 1171,
      "versionNonce": 504420162,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794756174384,
      "link": null,
      "locked": false,
      "text": "QUERY PARAMETERS:\n    - startTime| long   | Epoch timestamp in seconds. The matchlist started stoing timestamps on June 16th 2021. Any matches played before June 16th, 2021 won't be included in the result\n    - endTime  | string | Epoch timestamp in seconds.\n    - queue    | int    | Filter the list of match ids by a specific queue id. This filter is mutually inclusive of the type filter meaning any match ids returned must match both the queue and type filters.\n    - type     | string | Filter the list of match ids by the type of match. This filter is mutually inclusive of the queue filter meaning any match ids returned must match both the queue and type filters.\n    - start    | int    | Defaults to 0. Start index.\n    - count    | int    | Deafults to 20. Valid values 0 to 100. Number of match ids to return",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "QUERY PARAMETERS:\n    - startTime| long   | Epoch timestamp in seconds. The matchlist started stoing timestamps on June 16th 2021. Any matches played before June 16th, 2021 won't be included in the result\n    - endTime  | string | Epoch timestamp in seconds.\n    - queue    | int    | Filter the list of match ids by a specific queue id. This filter is mutually inclusive of the type filter meaning any match ids returned must match both the queue and type filters.\n    - type     | string | Filter the list of match ids by the type of match. This filter is mutually inclusive of the queue filter meaning any match ids returned must match both the queue and type filters.\n    - start    | int    | Defaults to 0. Start index.\n    - count    | int    | Deafults to 20. Valid values 0 to 100. Number of match ids to return",
      "autoResize": true,
      "lineHeight": 1.25
    },
